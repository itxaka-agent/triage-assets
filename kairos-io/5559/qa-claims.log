   134		return nil
   135	}

-- https://github.com/kairos-io/kairos/blob/v4.4.0/agent/internal/agent/hooks/gruboptions.go#L159-L175
   159	// GrubFirstBootOptions is a hook that runs on the first boot to add grub options.
   160	type GrubFirstBootOptions struct{}
   161	
   162	func (b GrubFirstBootOptions) Run(c sdkConfig.Config, _ sdkSpec.Spec) error {
   163		if len(c.GrubOptions) == 0 {
   164			return nil
   165		}
   166		// A UKI boot takes its command line from the signed .cmdline section of
   167		// the image, so a grubenv written here is read by nobody. Skip for the
   168		// same reason GrubPostInstallOptions does, and say so, because the key
   169		// was set on purpose and the user needs to know it did not take effect.
   170		if isUkiBoot(c) {
   171			c.Logger.Logger.Warn().Msg("Skipping GrubFirstBootOptions hook in uki mode: grub_options writes a grubenv that a UKI boot never reads, the kernel command line comes from the signed .cmdline s
   172			return nil
   173		}
   174		c.Logger.Logger.Info().Msg("Running GrubOptions hook")
   175		c.Logger.Debugf("Setting grub options: %s", c.GrubOptions)

-- https://github.com/kairos-io/kairos/blob/v4.4.0/agent/internal/agent/hooks/gruboptions.go#L191-L210
   191		if err := grubOptions(c, c.GrubOptions, oemEncrypted); err != nil {
   192			if errors.Is(err, errOEMUnavailable) {
   193				// The agent service also runs on live and netboot nodes, where
   194				// /oem holds the datasource userdata and there is no COS_OEM to
   195				// write to. Nothing was written, so the protection against
   196				// putting the options onto the ephemeral root still holds, and
   197				// there is no broken partition to shout about.
   198				c.Logger.Logger.Warn().Err(err).Msg("Could not reach the OEM partition, leaving the grub options unwritten")
   199				return nil
   200			}
   201			// Logged, not returned, for the reason FirstBootStage gives: this
   202			// hook runs inside the sentinel-gated first boot block, so returning
   203			// here aborts the chain before the firstboot sentinel is written and
   204			// before the bootstrap event that starts the k3s or k0s provider. The
   205			// node would then never finish its first boot and would repeat the
   206			// whole block, bundles included, on every restart of the agent unit.
   207			// An unwritten grubenv is worth a loud log, not that.
   208			c.Logger.Logger.Err(err).Msg("Failed setting grub options, continuing so the firstboot sentinel still gets written")
   209			return nil
   210		}

