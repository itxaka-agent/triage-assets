-- https://github.com/kairos-io/kairos/blob/v4.4.0/immucore/pkg/dag/dag_live_media.go#L9-L31
     9	// RegisterLiveMedia registers the dag for booting from live media/netboot
    10	// This mainly sets the sentinel, mounts oem if it can (failure is not fatal), runs rootfs and initramfs stages
    11	// And thats it.
    12	// There is a wait for sysroot to be there, just in case. Not waiting for it, can result in a race condition in which
    13	// sysroot is not ready when we try to mount oem and run stages
    14	// We let the actual init system deal with the mounts itself as we like hwo it setup cdrom mounts and such automatically.
    15	func RegisterLiveMedia(s *state.State, g *herd.Graph) error {
    16		// Maybe LogIfErrorAndPanic ? If no sentinel, a lot of config files are not going to run
    17		err := s.LogIfErrorAndReturn(s.WriteSentinelDagStep(g), "write sentinel")
    18	
    19		// Waits for sysroot to be there, just in case
    20		s.LogIfError(s.WaitForSysrootDagStep(g), "Waiting for sysroot")
    21		// Run rootfs
    22	
    23		// Try to mount oem ONLY if we are on recovery squash
    24		// The check to see if its enabled its on the DAG step itself
    25		s.LogIfError(s.MountOemDagStep(g, herd.WithDeps(cnst.OpWaitForSysroot)), "oem mount")
    26	
    27		s.LogIfError(s.RootfsStageDagStep(g, herd.WithDeps(cnst.OpSentinel, cnst.OpWaitForSysroot), herd.WithWeakDeps(cnst.OpMountOEM)), "rootfs stage")
    28		// Run initramfs inside the /sysroot chroot!
    29		s.LogIfError(s.InitramfsStageDagStep(g, herd.WithDeps(cnst.OpSentinel, cnst.OpWaitForSysroot, cnst.OpRootfsHook), herd.WithWeakDeps(cnst.OpMountOEM)), "initramfs stage")
    30		return err
    31	}

