######## 9. NOTE: wording 'after bundles are installed and grub options applied' - what those hooks do

-- https://github.com/kairos-io/kairos/blob/v4.4.0/agent/internal/agent/hooks/bundles.go#L120-L135
   120	// BundleFirstBoot installs bundles during the first boot of the machine
   121	type BundleFirstBoot struct{}
   122	
   123	func (b BundleFirstBoot) Run(c sdkConfig.Config, _ sdkSpec.Spec) error {
   124		c.Logger.Logger.Debug().Msg("Running BundleFirstBoot hook")
